# --- core ---
APP_ENV=dev
SECRET_KEY=change-me
PDN_MASTER_KEY=change-me-32-bytes-base64
# --- db ---
POSTGRES_DB=kadrovik
POSTGRES_USER=kadrovik
POSTGRES_PASSWORD=kadrovik
AUDIT_DB_PASSWORD=audit
# Local run outside docker (compose overrides these for containers):
DATABASE_URL=postgresql+psycopg://kadrovik:kadrovik@localhost:5432/kadrovik
AUDIT_DATABASE_URL=postgresql+psycopg://audit_writer:audit@localhost:5432/kadrovik
# --- redis / celery ---
REDIS_URL=redis://localhost:6379/0
# --- minio ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=documents
# --- documents ---
SOFFICE_URL=http://localhost:2004
TEMPLATES_DIR=./templates
# --- edo stub ---
EDO_OPERATOR=stub
EDO_STUB_FAIL_FORMAT=false
# --- autonomy ---
ORG_FIRST_30_DAYS_FORCE_A2=true
